; Engine configuration file.
; It's actually a .ini file, created automatically by Godot.
; Open this folder in Godot 4.5+ as a project.

config_version=5

[application]

config/name="Shape Farm"
config/description="Фармилка: разбивай группы одинаковых фигурок, копи монеты, покупай улучшения."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Bridge="*res://scripts/bridge.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
